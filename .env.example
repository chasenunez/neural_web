# Copy to .env.local for development; set as GitHub Actions secrets for prod.
#
# These are PUBLIC client IDs (no client secret involved with the Device
# Flow / PKCE). It's safe for them to ship in the deployed JS bundle.

# GitHub OAuth App Client ID (Settings → Developer settings → OAuth Apps).
# Required for Device Flow auth.
VITE_GITHUB_CLIENT_ID=

# The "owner/repo" of the PRIVATE vault repository memories are stored in.
# Example: chasenunez/ATHENA
VITE_VAULT_REPO=

# Dropbox App key (dropbox.com/developers/apps → Create app, App folder,
# scoped permissions: files.content.read).
VITE_DROPBOX_APP_KEY=

# Dropbox folder path that holds the family photo pool. Path is relative
# to the Dropbox app's root. Use "" for the app folder root.
VITE_DROPBOX_PHOTOS_PATH=/Family Vault Photos
