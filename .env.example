# Local development: copy to .env.local and fill in.
# Production: set these as GitHub Actions secrets in the code repo.
#
# These are PUBLIC client IDs (Device Flow + PKCE don't use client secrets).
# Safe to ship in the deployed JS bundle.

# GitHub OAuth App Client ID. github.com/settings/developers → OAuth Apps.
VITE_GITHUB_CLIENT_ID=

# The owner/repo of the private vault. Example: chasenunez/neural-vault
VITE_VAULT_REPO=

# Dropbox App key. dropbox.com/developers/apps → create app → scoped access.
VITE_DROPBOX_APP_KEY=

# Dropbox folder holding the shared photo pool. Empty = App folder root.
VITE_DROPBOX_PHOTOS_PATH=/Shared Photos
